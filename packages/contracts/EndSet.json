{
  "$defs": {
    "SelfReport": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "enum": [
            "easy",
            "ok",
            "hard"
          ],
          "title": "Effort",
          "type": "string"
        },
        "reps": {
          "maximum": 30,
          "minimum": 0,
          "title": "Reps",
          "type": "integer"
        }
      },
      "required": [
        "reps",
        "effort"
      ],
      "title": "SelfReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_version": {
      "minimum": 0,
      "title": "Expected Version",
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 64,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "self_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelfReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "set_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:_-]+$",
      "title": "Set Id",
      "type": "string"
    }
  },
  "required": [
    "expected_version",
    "idempotency_key",
    "set_id"
  ],
  "title": "EndSet",
  "type": "object"
}
