<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET" />
 <uses-feature android:name="android.software.leanback" android:required="true" />
 <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
 <application android:allowBackup="false" android:enableOnBackInvokedCallback="false" android:label="CleanRep" android:icon="@drawable/banner" android:banner="@drawable/banner" android:theme="@style/AppTheme" android:usesCleartextTraffic="${allowCleartext}" android:supportsRtl="true">
  <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboardHidden">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>
